   <string notr="true">
QWidget { font-family: &quot;Segoe UI&quot;, &quot;Ubuntu&quot;, &quot;Noto Sans&quot;, &quot;DejaVu Sans&quot;, sans-serif; font-size: 15px; color: #2B1608; }
QLabel { background: transparent; }
QPushButton { outline: none; }
QDialog#NouveauAchat { background: #FFFFFF; }
QFrame#headerWidget { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EA7210, stop:1 #D95F08); }
QLabel#titleLabel { color: #FFFFFF; font-size: 28px; font-weight: 700; }

QLabel#labelClient, QLabel#labelMateriel, QLabel#labelQuantite, QLabel#labelDate { font-size: 13px; font-weight: 700; }
QLabel#labelStock { font-size: 13px; font-weight: 600; color: #7A5C45; }

QComboBox, QDateEdit { min-height: 48px; padding: 0 14px; border: 1px solid #E6CFB8; border-radius: 10px; background: #FFF8F1; color: #2B1608; font-weight: 500; }
QLineEdit#champQuantite { min-width: 128px; min-height: 48px; padding: 0 12px; border: 1px solid #E6CFB8; border-radius: 10px; background: #FFF8F1; color: #2B1608; font-size: 15px; font-weight: 500; selection-background-color: #E8D5C0; selection-color: #2B1608; }
QPushButton#btnAugmenterQuantite, QPushButton#btnReduireQuantite { border: 1px solid #D7B99B; border-radius: 6px; background: #F1E3D3; color: #3A2414; font-size: 18px; font-weight: 800; }
QPushButton#btnAugmenterQuantite:hover, QPushButton#btnReduireQuantite:hover { background: #E8D5C0; border-color: #EA7210; }
QPushButton#btnAugmenterQuantite:pressed, QPushButton#btnReduireQuantite:pressed { background: #DDBF9F; }
QPushButton#btnAjouterArticle { min-height: 42px; padding: 0 16px; border: 0; border-radius: 8px; background: #315B47; color: white; font-weight: 700; }
QPushButton#btnAjouterArticle:hover { background: #264A39; }
QPushButton#btnRetirerArticle { min-height: 38px; padding: 0 14px; border: 1px solid #D9B8A0; border-radius: 8px; background: #FFF4EA; color: #8A3B24; font-weight: 700; }
QPushButton#btnRetirerArticle:hover { background: #F7E3D4; }
QLabel#labelArticlesCommande { font-size: 15px; font-weight: 700; }
QTableWidget#tableArticlesCommande { min-height: 140px; background: white; border: 1px solid #E6CFB8; gridline-color: #F0E1D2; selection-background-color: #FFEBD6; selection-color: #2B1608; }
QTableWidget#tableArticlesCommande::item { padding: 6px 10px; }
QComboBox:focus, QLineEdit#champQuantite:focus, QDateEdit:focus { border: 1px solid #EA7210; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #E6CFB8; selection-background-color: #FFEBD6; selection-color: #2B1608; outline: 0; }

QFrame#widgetTotal { background: #2B1608; border-radius: 12px; }
QLabel#labelMontantTitre { color: #E9D3BC; }
QLabel#labelStockInfo { color: #E9D3BC; font-size: 13px; }
QLabel#labelMontantValeur { color: #FFB066; font-size: 26px; font-weight: 700; }
QLabel#labelErreur { color: #B62F2F; font-weight: 600; }
QPushButton#btnAnnuler { min-height: 52px; padding: 0 20px; border: 0; border-radius: 12px; font-size: 17px; font-weight: 700; background: #F1E3D3; color: #2B1608; }
QPushButton#btnAnnuler:hover { background: #E8D5C0; }
QPushButton#btnEnregistrer { min-height: 52px; padding: 0 20px; border: 0; border-radius: 12px; font-size: 17px; font-weight: 700; color: #FFFFFF; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EA7210, stop:1 #D95F08); }
QPushButton#btnEnregistrer:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F5801E, stop:1 #E56A10); }
</string>
