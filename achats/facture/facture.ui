 <property name="styleSheet"><string notr="true">
QWidget { font-family: "Segoe UI", "Ubuntu", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 15px; color: #2B1608; }
QLabel { background: transparent; }
QPushButton { outline: none; }
QDialog#Facture { background: #FAF3EC; }
QFrame#feuille { background: #FFFFFF; border-radius: 16px; }
QLabel#labelFactureTitre { font-size: 28px; font-weight: 700; }
QLabel#labelStore { font-family: Georgia, "Times New Roman", serif; font-size: 22px; font-weight: 700; color: #B84A05; }
QLabel#labelNumClient, QLabel#labelDate, QLabel#labelNom, QLabel#labelTelephone { color: #7A5C45; }

QTableWidget#tableFacture { background: transparent; border: 0; outline: 0; }
QTableWidget#tableFacture::item { padding: 8px 12px; border-top: 1px solid #F0E1D2; }
QTableWidget#tableFacture QHeaderView { background: transparent; }
QTableWidget#tableFacture QHeaderView::section { background-color: #FFF1E2; border: 0; border-bottom: 2px solid #E8CFB8; color: #70421F; font-size: 12px; font-weight: 700; padding: 10px 12px; }

QFrame#widgetTotalFacture { background: #2B1608; border-radius: 12px; }
QLabel#labelTotalText { color: #E9D3BC; }
QLabel#labelTotalVal { color: #FFB066; font-size: 24px; font-weight: 700; }
QLabel#labelArretee { color: #7A5C45; }
QPushButton#btnFermerFacture { min-height: 52px; padding: 0 20px; border: 0; border-radius: 12px; font-size: 17px; font-weight: 700; background: #F1E3D3; color: #2B1608; }
QPushButton#btnFermerFacture:hover { background: #E8D5C0; }
QPushButton#btnGenererPdf { min-height: 52px; padding: 0 20px; border: 0; border-radius: 12px; font-size: 17px; font-weight: 700; color: #FFFFFF; background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EA7210, stop:1 #D95F08); }
QPushButton#btnGenererPdf:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F5801E, stop:1 #E56A10); }
